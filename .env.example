# ChainMarket Base Sepolia demo environment
# Demo-only setup for hackathon presentation
# Never commit real private keys

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org


# Frontend-friendly optional vars (Vite)
# Use any Base Sepolia RPC URL here, including provider URLs that contain API keys.
# Examples:
# - Public: https://sepolia.base.org
# - Alchemy: https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# - Infura:  https://base-sepolia.infura.io/v3/YOUR_API_KEY
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Required contract used for buyer buyItem() transaction
VITE_CONTRACT_ADDRESS=0xYourContractAddressHere

# Required demo signer for buyer transactions (never use production funds)
VITE_DEMO_PRIVATE_KEY=0xYourDemoPrivateKeyHere

# Fixed conversion rate for UI display
VITE_PHP_PER_ETH=180000

# Local SQLite API backend (Node + Express)
VITE_API_BASE_URL=http://localhost:3001

# Demo storage mode:
# - api: use SQLite API first and auto-fallback to local browser storage if API is unavailable
# - local: force browser-only storage (recommended for Netlify demo deployment)
VITE_DEMO_STORAGE_MODE=api

